theorem Ezpow_neg_mul (j : ℤ) : Ezpow (K := K) l e (-j) * Ezpow (K := K) l e j = 1 := by
  rw [Ezpow, Ezpow, ← Units.val_mul, ← _root_.zpow_add]
  simp

